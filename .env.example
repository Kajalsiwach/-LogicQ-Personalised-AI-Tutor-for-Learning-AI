# ==============================================================================
# LOGIQ Environment Configuration Template
# Copy this file to .env and configure your variables accordingly.
# Note: LOGIQ also features an in-app Settings modal to configure API keys at runtime.
# ==============================================================================

# Google Gemini API Key (Recommended)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# LLM Provider ('gemini' | 'openai' | 'anthropic' | 'custom')
VITE_LLM_PROVIDER=gemini

# Primary LLM Model Identifier (e.g., 'gemini-2.5-flash', 'gemini-1.5-pro')
VITE_LLM_MODEL=gemini-2.5-flash

# Optional Custom Endpoint URL (for proxy or enterprise deployments)
# VITE_LLM_ENDPOINT=https://generativelanguage.googleapis.com
